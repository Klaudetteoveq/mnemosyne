# Mnemosyne Configuration
# Copy this file to server/.env to override defaults.
# Everything works out of the box without this file.

# Neo4j credentials
NEO4J_USER=neo4j
NEO4J_PASSWORD=mnemosyne

# MCP server port (default: 8010)
MNEMOSYNE_PORT=8010

# --- RAG (optional — requires Ollama) ---
# Ollama server URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Embedding model (default: nomic-embed-text)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Generation model for mnemosyne_ask (default: qwen2.5-coder:32b)
# OLLAMA_CHAT_MODEL=qwen2.5-coder:32b

# Auto-embed memories on write (default: 0 = off, set to 1 to enable)
# MNEMOSYNE_EMBED_ON_WRITE=0
